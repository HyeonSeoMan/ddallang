{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "panda codegen --silent",
    "dev": "panda codegen --silent && concurrently -k -n panda,next \"panda --watch\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-http://localhost:3001} next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:latency": "vitest run --config vitest.latency.config.mts",
    "check:ac": "node scripts/check-ac.mjs",
    "smoke": "node scripts/smoke-routes.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "jotai": "^3.0.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@ddallang/typescript-config": "workspace:*",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "msw": "^3.0.5",
    "postcss": "^8.5.32",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
